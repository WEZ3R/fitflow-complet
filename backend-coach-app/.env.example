# Modèle de configuration — copier en .env et renseigner.
# Ce fichier est le SEUL des .env* à être versionné : il ne doit contenir aucune valeur réelle.

PORT=5001
NODE_ENV=development

# ─── Base de données ─────────────────────────────────────────────────────────
# Supabase expose deux chaînes de connexion, et les deux sont nécessaires :
#
#   DATABASE_URL  → le pooler (port 6543, pgbouncer). Utilisé par l'application.
#                   pgbouncer=true est obligatoire : sans lui, Prisma tente des
#                   requêtes préparées que le pooler en mode transaction rejette.
#
#   DIRECT_URL    → la connexion directe (port 5432). Utilisée uniquement par
#                   `prisma migrate`, qui a besoin d'une session persistante.
#
# En local (docker compose), les deux peuvent pointer sur la même URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── Authentification ────────────────────────────────────────────────────────
# Générer une valeur aléatoire : openssl rand -base64 48
# Toute rotation de ce secret déconnecte l'ensemble des utilisateurs.
JWT_SECRET=""
JWT_EXPIRES_IN=30d

# ─── CORS ───────────────────────────────────────────────────────────────────
# Origine du dashboard. En développement, le CORS est ouvert quel que soit ce champ.
FRONTEND_URL="http://localhost:3000"

# ─── Stockage des fichiers ──────────────────────────────────────────────────
# "local"    : disque du serveur (défaut). Inadapté à un hébergeur éphémère,
#              où les fichiers disparaissent à chaque déploiement.
# "supabase" : bucket Supabase Storage.
STORAGE_DRIVER=local
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="uploads"

# Cache Redis (optionnel — sans lui le backend interroge PostgreSQL)
REDIS_URL=redis://localhost:6379
