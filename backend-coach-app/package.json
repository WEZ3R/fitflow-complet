{
  "name": "coaching-app-backend",
  "version": "1.0.0",
  "description": "Backend pour application de coaching sportif",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "bash scripts/test-isolated.sh",
    "test:set-completions": "node --test __tests__/setCompletions.test.js",
    "test:parse": "node --test __tests__/parseSetData.test.js",
    "test:analytics": "node --test __tests__/workoutAnalytics.test.js",
    "test:sessions": "node --test __tests__/sessions.test.js",
    "test:auth": "node --test __tests__/auth.test.js",
    "test:programs": "node --test __tests__/programs.test.js",
    "test:stats": "node --test __tests__/stats.test.js",
    "test:messages": "node --test __tests__/messages.test.js",
    "test:requests": "node --test __tests__/requests.test.js",
    "test:goals": "node --test __tests__/goals.test.js",
    "seed": "node prisma/seed.js",
    "seed:exercises": "node prisma/seed-fitflow-exercises.js",
    "seed:ciqual": "node scripts/seed-ciqual.js",
    "seed:data": "npm run seed:exercises && npm run seed:ciqual",
    "env:linux": "bash scripts/switch-env.sh linux",
    "env:mac": "bash scripts/switch-env.sh mac",
    "env:windows": "bash scripts/switch-env.sh windows",
    "env:auto": "bash scripts/switch-env.sh auto",
    "db:host": "node scripts/detect-db-host.js",
    "db:backup": "cd scripts && ./export-database.sh",
    "db:restore": "cd scripts && ./import-database.sh",
    "test:isolated": "bash scripts/test-isolated.sh",
    "test:db:reset": "RESET_DB=1 bash scripts/test-isolated.sh",
    "test:authz": "node --test __tests__/authorization.test.js",
    "supabase:check": "node scripts/supabase-check.mjs",
    "supabase:migrate": "bash scripts/supabase-migrate.sh",
    "import:gyms": "node scripts/import-gyms-sirene.js",
    "import:gyms:osm": "node scripts/import-gyms-osm.js",
    "gyms:clean": "node scripts/clean-gyms.js",
    "test:raw": "node --test --test-concurrency=1 __tests__/auth.test.js __tests__/programs.test.js __tests__/sessions.test.js __tests__/stats.test.js __tests__/messages.test.js __tests__/requests.test.js __tests__/goals.test.js __tests__/setCompletions.test.js __tests__/workoutAnalytics.test.js __tests__/authorization.test.js __tests__/moderation.test.js __tests__/analytics.test.js",
    "db:purge-tests": "node scripts/purge-test-accounts.js",
    "test:moderation": "node --test __tests__/moderation.test.js"
  },
  "keywords": [
    "coaching",
    "fitness",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "@supabase/supabase-js": "^2.112.4",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "prisma": "^5.9.1",
    "redis": "^6.2.1",
    "rrule": "^2.8.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
